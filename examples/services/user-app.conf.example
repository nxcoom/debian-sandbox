; 任意常驻程序示例。复制到 /home/container/sandbox/services/<名字>.conf 后执行:
;   supervisorctl reread && supervisorctl update
[program:myapp]
directory=/home/container/myapp
command=/usr/bin/python3 -m http.server 8000
autostart=true
autorestart=true
startretries=10
redirect_stderr=true
stdout_logfile=/home/container/sandbox/logs/myapp.log
