#!/bin/bash
# ============================================================
# sandbox-keepalive — 低占用保活脚本（防止面板冻结空闲容器）
#
# 产出三类"活跃信号"：
#   1) CPU：每轮短促计算突发（纯 bash 忙询，默认 500ms/60s，平均 <1%）
#   2) 网络：轻量 HTTPS 心跳（204/trace 端点，KB 级流量，端点轮换）
#   3) 终端：周期性向容器控制台输出一行（面板可见）+ touch 心跳文件
#
# 由 supervisord 托管（sandbox-init 自动注册），心跳输出直接进容器控制台
# 关闭: 面板环境变量 SANDBOX_KEEPALIVE=0
# 调强度: KEEPALIVE_INTERVAL / KEEPALIVE_CPU_MS / KEEPALIVE_NET / KEEPALIVE_CONSOLE / KEEPALIVE_EVERY
# ============================================================

INTERVAL="${KEEPALIVE_INTERVAL:-60}"
CPU_MS="${KEEPALIVE_CPU_MS:-500}"
NET="${KEEPALIVE_NET:-1}"
CONSOLE="${KEEPALIVE_CONSOLE:-1}"
EVERY="${KEEPALIVE_EVERY:-5}"

HBFILE="/home/container/sandbox/.keepalive"
mkdir -p /home/container/sandbox 2>/dev/null

ENDPOINTS=(
  "https://www.cloudflare.com/cdn-cgi/trace"
  "https://www.google.com/generate_204"
  "https://cp.cloudflare.com/generate_204"
)

# CPU 突发：纯 bash 忙询 CPU_MS 毫秒（EPOCHREALTIME 微秒精度，无 fork 开销）
cpu_burst() {
  local end=$(( ${EPOCHREALTIME/./} + CPU_MS * 1000 ))
  local x=1
  while [ "${EPOCHREALTIME/./}" -lt "$end" ]; do
    x=$(( (x * 1103515245 + 12345) & 0x7fffffff ))
  done
}

i=0
echo "[keepalive] started: interval=${INTERVAL}s cpu=${CPU_MS}ms/cycle net=$NET console=$CONSOLE"
while :; do
  i=$((i+1))

  # 1) CPU 活动
  cpu_burst

  # 2) 网络活动（端点轮换，失败静默）
  if [ "$NET" = "1" ]; then
    ep="${ENDPOINTS[$(( i % ${#ENDPOINTS[@]} ))]}"
    curl -fsS -o /dev/null --max-time 8 "$ep" 2>/dev/null || true
  fi

  # 3) 文件系统心跳
  touch "$HBFILE" 2>/dev/null

  # 控制台心跳（每 N 轮一行，面板控制台可见）
  if [ "$CONSOLE" = "1" ] && [ $(( i % EVERY )) -eq 0 ]; then
    echo "[keepalive] alive $(date '+%F %T') up=$(cut -d' ' -f1 /proc/uptime)"
  fi

  sleep "$INTERVAL"
done
