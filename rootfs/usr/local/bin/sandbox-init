#!/bin/bash
# ============================================================
# sandbox-init — 面板沙箱容器的 init 入口（运行在 tini 之下）
#
# 兼容 Pterodactyl / Pelican (Wings) 面板:
#   * 读取 $STARTUP 环境变量并做 {{VAR}} -> ${VAR} 替换，作为主进程前台运行
#   * STARTUP 为空 / 为 "sandbox-init" 时进入守护模式
#
# 守护模式:
#   * supervisord 管理常驻服务（内置 sshd + 用户自定义服务）
#   * 真实 root SSH 监听 ${SERVER_PORT:-22}
#   * root 密码: /home/container/sandbox/.rootpass（首次启动随机生成并打印到控制台）
#   * 公钥:      /home/container/sandbox/authorized_keys
#
# 用户扩展（都在持久卷 /home/container 下，重启不丢）:
#   /home/container/sandbox/services/*.conf    supervisord 服务配置
#   /home/container/sandbox/prestart.d/*.sh    每次启动前执行的钩子
#   supervisorctl status|start|stop|restart|tail
# ============================================================
set -u

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LANG="${LANG:-C.UTF-8}"
export TZ="${TZ:-Asia/Shanghai}"
# wings 约定 HOME=/home/container（与 yolks 行为一致，保证面板自带 start.sh 兼容）
export HOME="/home/container"

CONTAINER_DIR="/home/container"
SANDBOX_DIR="$CONTAINER_DIR/sandbox"
SERVICES_DIR="$SANDBOX_DIR/services"
PRESTART_USER="$SANDBOX_DIR/prestart.d"
PRESTART_IMAGE="/etc/sandbox/prestart.d"
LOG_DIR="$SANDBOX_DIR/logs"

C='\033[0;36m'; G='\033[0;32m'; Y='\033[1;33m'; N='\033[0m'
log()  { printf "${C}[init]${N} %s\n" "$*"; }
warn() { printf "${Y}[init]${N} %s\n" "$*"; }

mkdir -p "$CONTAINER_DIR" "$SERVICES_DIR" "$PRESTART_USER" "$LOG_DIR" \
         /run/sshd /var/log/supervisor
cd "$CONTAINER_DIR"

# ---------- 面板兼容: 内部 IP / STARTUP 变量替换 ----------
INTERNAL_IP="$(ip route get 1 2>/dev/null | awk '{print $(NF-2); exit}')"
export INTERNAL_IP
log "INTERNAL_IP=${INTERNAL_IP:-n/a}  SERVER_PORT=${SERVER_PORT:-unset}  TZ=$TZ"

STARTUP_MODE="daemon"
MODIFIED_STARTUP=""
if [ -n "${STARTUP:-}" ]; then
  case "$STARTUP" in
    sandbox-init|/usr/local/bin/sandbox-init)
      log "STARTUP=sandbox-init -> 守护模式"
      ;;
    *)
      STARTUP_MODE="script"
      MODIFIED_STARTUP="$(echo "$STARTUP" | sed -e 's/{{/${/g' -e 's/}}/}/g')"
      ;;
  esac
fi

# ---------- root SSH 准备（host key 持久化，避免客户端警告变更） ----------
HOSTKEY_DIR="$SANDBOX_DIR/hostkeys"
mkdir -p "$HOSTKEY_DIR"
if ! ls "$HOSTKEY_DIR"/ssh_host_*_key >/dev/null 2>&1; then
  log "生成 SSH host keys（持久化到 $HOSTKEY_DIR）"
  ssh-keygen -A >/dev/null 2>&1
  cp /etc/ssh/ssh_host_* "$HOSTKEY_DIR/" 2>/dev/null
else
  cp "$HOSTKEY_DIR"/ssh_host_* /etc/ssh/ 2>/dev/null
fi

ROOTPASS_FILE="$SANDBOX_DIR/.rootpass"
if [ ! -s "$ROOTPASS_FILE" ]; then
  ROOT_PW="$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 16)"
  printf '%s\n' "$ROOT_PW" > "$ROOTPASS_FILE"
  chmod 600 "$ROOTPASS_FILE"
  printf "${G}[init] root SSH 密码: %s${N}\n" "$ROOT_PW"
  log "密码已保存到 $ROOTPASS_FILE（持久化；编辑后重启容器生效）"
else
  ROOT_PW="$(head -n 1 "$ROOTPASS_FILE" | tr -d '\r\n')"
  log "使用 $ROOTPASS_FILE 中已有的 root 密码"
fi
echo "root:${ROOT_PW}" | chpasswd >/dev/null 2>&1 || warn "设置 root 密码失败"

if [ -f "$SANDBOX_DIR/authorized_keys" ]; then
  mkdir -p /root/.ssh && chmod 700 /root/.ssh
  cp "$SANDBOX_DIR/authorized_keys" /root/.ssh/authorized_keys
  chmod 600 /root/.ssh/authorized_keys
  log "已安装 authorized_keys"
fi

# ---------- prestart 钩子 ----------
for d in "$PRESTART_IMAGE" "$PRESTART_USER"; do
  [ -d "$d" ] || continue
  for f in "$d"/*.sh; do
    [ -e "$f" ] || continue
    log "prestart: $f"
    bash "$f" || warn "prestart 失败（已忽略）: $f"
  done
done

# ---------- 内置 sshd 是否启动 ----------
# auto: 守护模式开启；脚本模式关闭（避免和面板自带 sshd 抢 SERVER_PORT）
SSHD_MODE="${SANDBOX_SSHD:-auto}"
if [ "$SSHD_MODE" = "auto" ]; then
  if [ "$STARTUP_MODE" = "script" ]; then SSHD_MODE="never"; else SSHD_MODE="always"; fi
fi

SSHD_CONF="/etc/supervisor/conf.d/zz-sandbox-sshd.conf"
rm -f "$SSHD_CONF"
if [ "$SSHD_MODE" != "never" ]; then
  SSH_PORT="${SERVER_PORT:-22}"
  cat > "$SSHD_CONF" <<EOF
[program:sshd]
command=/bin/sh -c 'mkdir -p /run/sshd && exec /usr/sbin/sshd -D -e -o Port=${SSH_PORT} -o PasswordAuthentication=yes -o PermitRootLogin=yes'
autostart=true
autorestart=true
startretries=10
redirect_stderr=true
stdout_logfile=/var/log/supervisor/sshd.log
EOF
  log "内置 sshd 将监听端口 $SSH_PORT（SANDBOX_SSHD=$SSHD_MODE）"
fi

# ---------- 启动服务管理器 ----------
supervisord -c /etc/supervisor/supervisord.conf
sleep 0.3

shutdown() {
  warn "收到停止信号，关闭服务并退出"
  supervisorctl shutdown >/dev/null 2>&1
  [ -n "${MAIN_PID:-}" ] && kill "$MAIN_PID" 2>/dev/null
  exit 0
}
trap shutdown TERM INT HUP

banner() {
  echo
  echo "============================================================"
  echo " Debian Sandbox 镜像就绪"
  echo "------------------------------------------------------------"
  echo " 服务管理:  supervisorctl status"
  echo " 加服务:    $SERVICES_DIR/*.conf"
  echo "            改后执行: supervisorctl reread && supervisorctl update"
  echo " 日志:      /var/log/supervisor/  和  $LOG_DIR/"
  echo " root SSH:  端口 ${SERVER_PORT:-22}，密码在 $ROOTPASS_FILE"
  echo " 持久目录:  $CONTAINER_DIR（容器其余路径重启会还原）"
  echo " 工具:      curl wget ip ss dig nmap tcpdump socat nc iperf3 mtr"
  echo "            git python3 pip jq rsync ssh cloudflared aria2 iptables ..."
  echo "============================================================"
  echo
}

MAIN_PID=""
if [ "$STARTUP_MODE" = "script" ]; then
  banner
  log "执行启动命令: $MODIFIED_STARTUP"
  bash -c "$MODIFIED_STARTUP" &
  MAIN_PID=$!
  wait "$MAIN_PID"
  RC=$?
  log "启动命令退出（code=$RC），正在关闭服务..."
else
  banner
  log "守护模式：常驻运行，服务用 supervisorctl 管理"
  ( while :; do sleep 3600; done ) &
  MAIN_PID=$!
  wait "$MAIN_PID"
  RC=0
fi

supervisorctl shutdown >/dev/null 2>&1 || true
exit $RC
