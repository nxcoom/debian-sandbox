#!/bin/bash
# ============================================================
# sandbox-init v8 — 面板沙箱容器的 init 入口（运行在 tini 之下）
#
# 平台约束（实测 tryaltare）:
#   * 容器根文件系统只读，唯一可写卷 = /home/container
#   * 容器以非 root 运行；PID1 的 stdin = 面板控制台 tty (/dev/pts/0)
#   * 后台子 shell 的 stdin 会被 bash 接到 /dev/null（v4-v7 刷屏根因）
#   * => 控制台交互必须由前台进程直接 read stdin，绝不放进后台 &
#
# v9 修复（在 v8 前台 REPL 基础上）:
#   - 双 SSH 共存：主端口(SERVER_PORT) altare-sshd(proot/密码) +
#     第二端口(SANDBOX_DROPBEAR_PORT 默认25270) dropbear(容器层/公钥)
#   - 控制台 REPL 默认关闭（SANDBOX_CONSOLE_SHELL=1 才开），彻底杜绝刷屏
#   - 清理旧版 zz-ssh.conf 残留
# v8 修复:
#   - 移除后台 console_repl_loop，改为前台 REPL（直接读主进程 stdin）
#   - read 返回 EOF 时长睡眠（300s），关闭面板再开不会再刷屏
#   - 命令执行用 bash -c（子 shell），exit 等内置命令不会杀死 REPL
# ============================================================
set -u

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LANG="${LANG:-C.UTF-8}"
export TZ="${TZ:-Asia/Shanghai}"
export HOME="/home/container"

CONTAINER_DIR="/home/container"
SANDBOX_DIR="$CONTAINER_DIR/sandbox"
SERVICES_DIR="$SANDBOX_DIR/services"
PRESTART_USER="$SANDBOX_DIR/prestart.d"
PRESTART_IMAGE="/etc/sandbox/prestart.d"
SUPD_DIR="$SANDBOX_DIR/supervisor.d"
LOG_DIR="$SANDBOX_DIR/logs"

C='\033[0;36m'; G='\033[0;32m'; Y='\033[1;33m'; N='\033[0m'
log()  { printf "${C}[init]${N} %s\n" "$*"; }
warn() { printf "${Y}[init]${N} %s\n" "$*"; }

mkdir -p "$CONTAINER_DIR" "$SERVICES_DIR" "$PRESTART_USER" "$SUPD_DIR" "$LOG_DIR"
cd "$CONTAINER_DIR"

# ---------- 面板兼容: 内部 IP / STARTUP 变量替换 ----------
INTERNAL_IP="$(ip route get 1 2>/dev/null | awk '{print $(NF-2); exit}')"
export INTERNAL_IP
log "uid=$(id -u)  INTERNAL_IP=${INTERNAL_IP:-n/a}  SERVER_PORT=${SERVER_PORT:-unset}  TZ=$TZ"

STARTUP_MODE="daemon"
MODIFIED_STARTUP=""
if [ -n "${STARTUP:-}" ]; then
  case "$STARTUP" in
    sandbox-init|/usr/local/bin/sandbox-init)
      log "STARTUP=sandbox-init -> 守护模式"
      ;;
    *)
      STARTUP_MODE="script"
      MODIFIED_STARTUP="$(echo "$STARTUP" | sed -e 's/{{/${/g' -e 's/}}/}/g')"
      ;;
  esac
fi

# ---------- prestart 钩子 ----------
for d in "$PRESTART_IMAGE" "$PRESTART_USER"; do
  [ -d "$d" ] || continue
  for f in "$d"/*.sh; do
    [ -e "$f" ] || continue
    log "prestart: $f"
    bash "$f" || warn "prestart 失败（已忽略）: $f"
  done
done

SSH_PORT="${SERVER_PORT:-22}"
SSH_MODE_DESC="none"

# ---------- SSH（仅守护模式；由 supervisord 托管） ----------
# v9: 双端口共存 —— 主端口 SERVER_PORT 给平台 altare-sshd（proot/密码），
#     第二端口 SANDBOX_DROPBEAR_PORT（默认 25270）给 dropbear（容器层/公钥）。
#     两者互不冲突；公钥登录容器层不再牺牲面板密码登录。
if [ "$STARTUP_MODE" = "daemon" ]; then
  # 清理旧版本残留配置（v3-v8 的 zz-ssh.conf 会抢占端口）
  rm -f "$SUPD_DIR/zz-ssh.conf" "$SUPD_DIR/zz-sandbox-sshd.conf"

  # --- 1) 平台 altare-sshd 永远留在主端口（除非 SANDBOX_ALTARE_SSHD=0） ---
  ALTARE_PORT="${SERVER_PORT:-22}"
  if [ "${SANDBOX_ALTARE_SSHD:-1}" = "1" ] && [ -x "$CONTAINER_DIR/.sandbox/altare-sshd" ]; then
    ( cd "$CONTAINER_DIR" && nohup ./.sandbox/altare-sshd >/dev/null 2>&1 & )
    log "SSH 主端口 ${ALTARE_PORT}: 平台 altare-sshd（proot 环境，凭据同面板）"
    SSH_MODE_DESC="主端口 ${ALTARE_PORT}=altare(proot/密码)"
  fi

  # --- 2) dropbear 在第二端口（容器层，公钥） ---
  # 端口选择：显式 SANDBOX_DROPBEAR_PORT > 自动探测(主端口+1 或常见 25270) > 不启动
  DB_PORT="${SANDBOX_DROPBEAR_PORT:-}"
  if [ -z "$DB_PORT" ]; then
    # 常见面板第二端口就是主端口-1（25412 -> 25270 这种不一定成立），
    # 这里默认 25270；如需其它端口请在面板加环境变量 SANDBOX_DROPBEAR_PORT
    DB_PORT="25270"
  fi
  # v16: 公钥内置——卷里没有就把镜像里的模板复制过去（新容器开箱即用）
  mkdir -p "$CONTAINER_DIR/.ssh" 2>/dev/null
  if [ ! -s "$CONTAINER_DIR/.ssh/authorized_keys" ] && [ -s /etc/sandbox/authorized_keys ]; then
    cp /etc/sandbox/authorized_keys "$CONTAINER_DIR/.ssh/authorized_keys" 2>/dev/null
  fi
  chmod 700 "$CONTAINER_DIR/.ssh" 2>/dev/null
  chmod 600 "$CONTAINER_DIR/.ssh/authorized_keys" 2>/dev/null
  if [ "${SANDBOX_DROPBEAR:-1}" = "1" ] && [ "$DB_PORT" != "$ALTARE_PORT" ] \
     && [ -s "$CONTAINER_DIR/.ssh/authorized_keys" ]; then
    # v14: host key 目录必须归当前 uid 所有，否则换节点后 uid 变化
    # （旧机器 988 / 新机器 999）无法在里面生成 key，ssh-keygen 静默失败，
    # sshd 反复 "no hostkeys available" 崩溃。用独立新目录 + 写测试确认可写。
    HK_DIR="$SANDBOX_DIR/sshd_hostkeys"; mkdir -p "$HK_DIR" 2>/dev/null
    if ! touch "$HK_DIR/.wtest" 2>/dev/null; then
      HK_DIR="$SANDBOX_DIR/hk-$(id -u)"; mkdir -p "$HK_DIR" 2>/dev/null
    fi
    rm -f "$HK_DIR/.wtest" 2>/dev/null
    HK_ED="$HK_DIR/ssh_host_ed25519_key"
    HK_RSA="$HK_DIR/ssh_host_rsa_key"
    # v16: host key 从镜像内置模板复制（不依赖 ssh-keygen 的 uid 写权限，
    # 换节点 uid 变化也不怕）。模板在 /etc/sandbox/hostkeys/，构建时烧入。
    if [ ! -s "$HK_ED" ] && [ -s /etc/sandbox/hostkeys/ssh_host_ed25519_key ]; then
      cp /etc/sandbox/hostkeys/ssh_host_ed25519_key "$HK_ED" 2>/dev/null
    fi
    if [ ! -s "$HK_RSA" ] && [ -s /etc/sandbox/hostkeys/ssh_host_rsa_key ]; then
      cp /etc/sandbox/hostkeys/ssh_host_rsa_key "$HK_RSA" 2>/dev/null
    fi
    # 兜底：模板也没有就现场生成
    [ -s "$HK_ED" ] || ssh-keygen -q -t ed25519 -N '' -f "$HK_ED" </dev/null 2>/dev/null || true
    [ -s "$HK_RSA" ] || ssh-keygen -q -t rsa -b 2048 -N '' -f "$HK_RSA" </dev/null 2>/dev/null || true
    chmod 600 "$HK_ED" "$HK_RSA" 2>/dev/null
    SSHD_CONF="$SANDBOX_DIR/sshd_config"
    # 非 root sshd 需要在可写目录放 privilege separation / pid；/run 在只读根下
    # 用镜像层预建的 /run/sshd，pid/日志都在持久卷。
    mkdir -p /run/sshd 2>/dev/null || true
    cat > "$SSHD_CONF" <<EOF
Port ${DB_PORT}
ListenAddress 0.0.0.0
HostKey $HK_RSA
HostKey $HK_ED
UsePAM no
PasswordAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile ${CONTAINER_DIR}/.ssh/authorized_keys
PermitRootLogin no
AllowUsers container
StrictModes no
PrintMotd no
SyslogFacility AUTH
LogLevel VERBOSE
PidFile ${SANDBOX_DIR}/sshd.pid
Subsystem sftp internal-sftp
EOF
    cat > "$SUPD_DIR/zz-dropbear.conf" <<EOF
[program:dropbear]
command=/bin/sh -c 'export LD_PRELOAD="/etc/sandbox/fakepw.so /etc/sandbox/chroot-noop.so"; exec /usr/sbin/sshd -D -e -f ${SSHD_CONF}'
directory=/home/container
autostart=true
autorestart=true
startretries=10
redirect_stderr=true
stdout_logfile=/home/container/sandbox/logs/sshd.log
EOF
    SSH_MODE_DESC="${SSH_MODE_DESC} + 第二端口 ${DB_PORT}=openssh(容器层/公钥)"
    log "SSH 第二端口 ${DB_PORT}: OpenSSH 容器层直连（公钥: ~/.ssh/authorized_keys）"
  else
    rm -f "$SUPD_DIR/zz-dropbear.conf"
    if [ "${SANDBOX_DROPBEAR:-1}" = "1" ] && [ ! -s "$CONTAINER_DIR/.ssh/authorized_keys" ]; then
      log "dropbear 未启用：~/.ssh/authorized_keys 为空（放公钥后重启即可启用第二端口）"
    fi
  fi

  # ---- 内置保活 ----
  KEEPALIVE_CONF="$SUPD_DIR/zz-keepalive.conf"
  if [ "${SANDBOX_KEEPALIVE:-1}" = "1" ]; then
    cat > "$KEEPALIVE_CONF" <<EOF
[program:keepalive]
command=/bin/bash /usr/local/bin/sandbox-keepalive
autostart=true
autorestart=true
startretries=10
redirect_stderr=true
stdout_logfile=/home/container/sandbox/logs/keepalive.log
environment=KEEPALIVE_INTERVAL="${KEEPALIVE_INTERVAL:-60}",KEEPALIVE_CPU_MS="${KEEPALIVE_CPU_MS:-500}",KEEPALIVE_NET="${KEEPALIVE_NET:-1}",KEEPALIVE_CONSOLE="${KEEPALIVE_CONSOLE:-1}",KEEPALIVE_EVERY="${KEEPALIVE_EVERY:-5}"
EOF
    log "保活已启用（CPU 突发 + 网络心跳 + 控制台心跳）"
  else
    rm -f "$KEEPALIVE_CONF"
    log "保活已禁用（SANDBOX_KEEPALIVE=0）"
  fi

  # ---- 容器层提示符（dropbear 登录 shell 用） ----
  if [ ! -f "$CONTAINER_DIR/.bashrc" ]; then
    printf "%s\n" "export PS1='\[\e[36m\][sandbox]\[\e[0m\] \w \$ '" > "$CONTAINER_DIR/.bashrc"
    printf "%s\n" "case \$- in *i*) . \$HOME/.bashrc;; esac" > "$CONTAINER_DIR/.profile"
  fi
fi

# ---------- 启动 supervisord（后台） ----------
SUP_PID=""
supervisord -c /etc/supervisor/supervisord.conf &
SUP_PID=$!
sleep 0.5

# supervisor 看门狗（后台）
WATCH_PID=""
sup_watch() {
  while :; do
    if ! kill -0 "$SUP_PID" 2>/dev/null; then
      warn "supervisord 退出，重启..."
      supervisord -c /etc/supervisor/supervisord.conf &
      SUP_PID=$!
    fi
    sleep 60
  done
}
sup_watch &
WATCH_PID=$!

shutdown() {
  warn "收到停止信号，关闭服务"
  [ -n "$WATCH_PID" ] && kill "$WATCH_PID" 2>/dev/null
  supervisorctl shutdown >/dev/null 2>&1
  [ -n "$SUP_PID" ] && kill "$SUP_PID" 2>/dev/null
  exit 0
}
trap shutdown TERM INT HUP

banner() {
  echo
  echo "============================================================"
  echo " Debian Sandbox 就绪（uid=$(id -u)，根只读，持久卷 /home/container）"
  echo "------------------------------------------------------------"
  echo " 容器层工具: ping dig nmap tcpdump socat nc iperf3 mtr git"
  echo "             python3 pip jq rsync ssh cloudflared aria2 ..."
  echo " 服务管理:   supervisorctl status"
  echo " SSH:        $SSH_MODE_DESC"
  echo " 保活:       keepalive 运行中（SANDBOX_KEEPALIVE=0 关闭）"
  echo "============================================================"
  echo
}

# ---------- 前台控制台 REPL（v8 核心：直接读主进程 stdin，绝不放到后台） ----------
console_repl() {
  log "控制台就绪（前台 REPL；输入命令执行，Ctrl-D 后 300s 内可重连）"
  local line
  while :; do
    printf '\033[0;36m[sandbox]\033[0m %s $ ' "$(pwd)"
    if ! IFS= read -r line; then
      # stdin EOF（面板关闭）：长睡眠，避免空转刷屏；tini 收到 TERM 会被 trap 打断
      sleep 300
      continue
    fi
    [ -z "$line" ] && continue
    if printf '%s' "$line" | grep -Eq '^[[:space:]]*(exit|quit|logout)[[:space:]]*$'; then
      echo "[console] 面板控制台：exit 无效（用面板按钮停止容器）"
      continue
    fi
    # 用子 shell 执行：exit/cd 等内置命令不影响 REPL 自身
    bash -c "$line" 2>&1
  done
}

if [ "$STARTUP_MODE" = "script" ]; then
  banner
  log "执行启动命令: $MODIFIED_STARTUP"
  bash -c "$MODIFIED_STARTUP"
  RC=$?
  log "启动命令退出（code=$RC）"
else
  banner
  # v9: 默认关闭控制台 REPL（历史刷屏根源）；有 API + 双 SSH 后不再需要它。
  # 需要时可在面板设 SANDBOX_CONSOLE_SHELL=1 显式开启（前台 read，已不会刷屏）。
  if [ "${SANDBOX_CONSOLE_SHELL:-0}" = "1" ]; then
    console_repl            # 前台阻塞；stdin=面板 tty，正常等待输入
  else
    log "守护模式：常驻运行（控制台 REPL 默认关闭；用 SSH/API 操作容器层）"
    wait "$WATCH_PID"
  fi
  RC=0
fi

supervisorctl shutdown >/dev/null 2>&1 || true
exit $RC
